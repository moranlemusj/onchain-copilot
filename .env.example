# Copy to .env and fill in.

# Google AI Studio key for Gemini — https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Alchemy key — https://dashboard.alchemy.com/
ALCHEMY_API_KEY=

# Etherscan key — https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Optional: LangSmith for tracing — https://smith.langchain.com/
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=onchain-copilot

# Model knobs
GEMINI_MODEL=gemini-2.5-flash
ALCHEMY_NETWORK=eth-mainnet
